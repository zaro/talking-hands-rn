import WordsIndex from './words-index';

export default {
  panels:[
  {% for column in columns -%}
    {% for word, word_config in column -%}
    {% if loop.first %}
    {% if not word_config %}'{{ word }}'{% else %}null{% endif -%},
    {% else %}
    {% if not word_config %}'{{ word }}',{% endif -%}
    {% endif %}
    {% endfor -%}
  {%- endfor %}
  ],
  columns:[
    {% for column in columns -%}
    [
      {% for word, word_config in column -%}
      {% if word_config %}WordsIndex['{{word}}'],{% else %}// {{word}}{% endif %}
      {% endfor -%}
    ],
    {% endfor %}
  ]
};
