export default {
  lessons:[
    {% for lesson_name, lesson in lessons.items() -%}
    {
      'name': '{{ lesson_name}}',
    },
    {%- endfor %}
  ],
  lessonData: {
  {% for lesson_name, lesson in lessons.items() -%}
    '{{ lesson_name}}': require('./{{ lesson.filename }}'),
  {%- endfor %}
  },
  getLessonData(lessonName) {
    return this.lessonData[lessonName].default;
  }
};
